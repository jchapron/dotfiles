[user]
	name = Jérôme Chapron
	email = hello@jchapron.com
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

[core]
	editor = nvim
	pager = delta
	excludesfile = ~/.config/git/ignore
	autocrlf = input
	fsmonitor = true
	untrackedCache = true

[init]
	defaultBranch = main

[branch]
	sort = -committerdate
[column]
	ui = auto
[tag]
	sort = version:refname

[fetch]
	prune = true
	pruneTags = true
	all = true
[pull]
	rebase = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
	autoupdate = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[help]
	autocorrect = prompt

[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[delta]
	features = catppuccin-mocha
	navigate = true
	line-numbers = true
	side-by-side = false
	hyperlinks = true

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	ci = commit
	ca = commit --amend --no-edit
	lg = log --oneline --graph --decorate -20
	lga = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat
	undo = reset --soft HEAD~1
	unstage = restore --staged
	wip = !git add -A && git commit -m wip --no-verify
	pushf = push --force-with-lease
	root = rev-parse --show-toplevel
	go = "!f() { git switch -c \"$1\" 2>/dev/null || git switch \"$1\"; }; f"
	today = log --stat --since='1 Day Ago' --graph --pretty=oneline --abbrev-commit --date=relative
